# Copy to .env and adjust. Every variable is optional.

# Interface to bind. Defaults to loopback so the studio is only reachable from
# this machine. Set to 0.0.0.0 ONLY on a trusted network: the API has no
# authentication and every request can spawn ffmpeg / remote GPU jobs.
HOST=127.0.0.1
PORT=3000

# Hugging Face token. Used as a fallback for voice cloning, sound effects,
# ambient audio and video when the UI does not supply one. Anonymous access
# works but is queue-limited.
HF_TOKEN=

# Python interpreter used to run audio_engine.py (default: python3, or
# "python" on Windows).
# PYTHON=python3

# Abuse guards for the API (defaults shown).
# MAX_CONCURRENT_JOBS=2        # engine processes running at once
# RATE_LIMIT_PER_MINUTE=30     # POST /api/* requests per client IP per minute
# ENGINE_TIMEOUT_MS=300000     # kill an engine process after this long
# MAX_BODY_MB=25               # JSON / form body limit
